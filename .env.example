# SpendSense AI Configuration Environment Variables

# Secret key for encrypting Flask session cookies
SECRET_KEY=change-to-a-secure-random-string-in-production

# Flask debug mode (0 for production, 1 for local development)
FLASK_DEBUG=0

# Database Connection
# Local development default: sqlite:///expense_ai.db
# Render PostgreSQL default: automatically provided by Render as postgresql://...
DATABASE_URL=sqlite:///expense_ai.db

# Optional: Google Gemini API Key for AI Financial Copilot generative chat
# If omitted, SpendSense AI uses its built-in rule-based financial advisory engine
GEMINI_API_KEY=
